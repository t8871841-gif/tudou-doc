<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 外发光圆（径向渐变，弱化到边缘） -->
    <path android:pathData="M54,54 m-32,0 a32,32 0 1,1 64,0 a32,32 0 1,1 -64,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="32"
                android:startColor="#552A8CFF"
                android:centerColor="#1A2A8CFF"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>

    <!-- 外环：sweep 蓝→橙→蓝 -->
    <path
        android:pathData="M54,54 m-22,0 a22,22 0 1,1 44,0 a22,22 0 1,1 -44,0"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="sweep"
                android:startColor="#2A8CFF"
                android:centerColor="#FF7A2E"
                android:endColor="#2A8CFF" />
        </aapt:attr>
    </path>

    <!-- 中环：细冷蓝 -->
    <path
        android:pathData="M54,54 m-15,0 a15,15 0 1,1 30,0 a15,15 0 1,1 -30,0"
        android:strokeWidth="1.2"
        android:strokeColor="#2A8CFF"
        android:strokeAlpha="0.65"
        android:fillColor="#00000000" />

    <!-- 核心光球：白→琥珀→橙 -->
    <path android:pathData="M54,54 m-7.5,0 a7.5,7.5 0 1,1 15,0 a7.5,7.5 0 1,1 -15,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="52"
                android:centerY="52"
                android:gradientRadius="9"
                android:startColor="#FFFFFF"
                android:centerColor="#FFC08A"
                android:endColor="#FF7A2E" />
        </aapt:attr>
    </path>

    <!-- 高光点 -->
    <path
        android:pathData="M51.5,51.5 m-2,0 a2,2 0 1,1 4,0 a2,2 0 1,1 -4,0"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.9" />
</vector>
